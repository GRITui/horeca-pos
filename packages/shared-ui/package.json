{
  "name": "@grit/shared-ui",
  "version": "0.1.0",
  "private": true,
  "description": "GRITui — shared React component library for the Grit BizSuite apps. Tailwind v4 utility classes only, ships TypeScript source (no build step).",
  "type": "module",
  "main": "./src/index.ts",
