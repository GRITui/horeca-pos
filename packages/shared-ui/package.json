  "exports": {
    ".": "./src/index.ts",
    "./Button": "./src/Button.tsx",
    "./Input": "./src/Input.tsx",
    "./Table": "./src/Table.tsx",
    "./Panel": "./src/Panel.tsx",
    "./Badge": "./src/Badge.tsx",
    "./EmptyState": "./src/EmptyState.tsx",
    "./AppSwitcher": "./src/AppSwitcher.tsx"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
