# HS256 secret for Grit Passport JWT verification (falls back to SESSION_SECRET if unset)
GRIT_SESSION_SECRET=your-hs256-secret-here

# Legacy fallback for GRIT_SESSION_SECRET (only used if GRIT_SESSION_SECRET is unset)
SESSION_SECRET=your-session-secret-here

# Base URL of grit-pos for /api/reports/revenue endpoint
GRIT_POS_URL=https://pos.example.com

# Base URL of grit-inventory for /api/reports/cogs endpoint
GRIT_INVENTORY_URL=https://inventory.example.com

# Base URL of grit-taskboard for /api/ops-tasks endpoint
GRIT_TASKBOARD_URL=https://taskboard.example.com

# Bearer token forwarded on every upstream service-to-service call
GRIT_SERVICE_TOKEN=your-service-token-here
