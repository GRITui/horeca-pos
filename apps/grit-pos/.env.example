# Copy this file to .env and fill in a real Neon Postgres connection string.
# Never commit .env — only this .env.example template is tracked in git.
#
# Neon Postgres connection string (pooled, for use with Prisma).
# Get yours from the Neon console: https://console.neon.tech
DATABASE_URL="postgresql://neon_user:REPLACE_ME_FAKE_PASSWORD@ep-example-000000.us-east-2.aws.neon.tech/horeca_pos?sslmode=require"

# Secret used to sign staff session JWTs (HS256). Generate a strong random
# value, e.g.: openssl rand -base64 32
SESSION_SECRET="REPLACE_ME_FAKE_SESSION_SECRET"

# Stripe API keys. Get yours from the Stripe dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_REPLACE_ME_FAKE_STRIPE_SECRET_KEY"
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_ME_FAKE_STRIPE_WEBHOOK_SECRET"

# ---------------------------------------------------------------------------
# Grit BizSuite integration (ALL OPTIONAL — leave unset to run standalone;
# event publishing, cross-app nav and cron drains simply stay inert).
# ---------------------------------------------------------------------------

# Shared HMAC secret for @grit/shared-events internal webhooks.
#GRIT_EVENT_WEBHOOK_SECRET="REPLACE_ME_SHARED_EVENT_SECRET"

# Comma-separated subscriber URLs per outbound event.
#GRIT_SUBSCRIBERS_TRANSACTION_COMPLETED="https://inventory.example/api/events/grit"
#GRIT_SUBSCRIBERS_POS_VELOCITY_SURGE="https://taskboard.example/api/taskboard-webhook"

# Bearer secret protecting GET/POST /api/cron/events-drain (outbox retry).
#CRON_SECRET="REPLACE_ME_CRON_SECRET"

# pos.velocity_surge tuning (defaults: 10-minute window, threshold 25).
#GRIT_SURGE_WINDOW_MIN="10"
#GRIT_SURGE_THRESHOLD="25"

# Base URLs for the AppSwitcher cross-app nav (@grit/passport defaults to
# localhost dev ports 3000-3003 when unset).
#GRIT_POS_URL="http://localhost:3000"
#GRIT_INVENTORY_URL="http://localhost:3001"
#GRIT_TASKBOARD_URL="http://localhost:3002"
#GRIT_REPORTS_URL="http://localhost:3003"

# Bearer secret for service-to-service calls to GET /api/reports/revenue
# (grit-reports' margin aggregator has no staff session, so it authenticates
# with `Authorization: Bearer $GRIT_SERVICE_TOKEN` + `?organization_id=<tenant
# id>` instead). Leave unset to disable that path entirely — the endpoint
# still works for logged-in staff via the normal session cookie either way.
#GRIT_SERVICE_TOKEN="REPLACE_ME_GRIT_SERVICE_TOKEN"
