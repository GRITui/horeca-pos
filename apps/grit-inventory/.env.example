# Copy this file to .env and fill in a real Neon Postgres connection string.
# Never commit .env — only this .env.example template is tracked in git.
#
# Neon Postgres connection string (pooled, for use with Prisma).
# Get yours from the Neon console: https://console.neon.tech
DATABASE_URL="postgresql://neon_user:REPLACE_ME_FAKE_PASSWORD@ep-example-000000.us-east-2.aws.neon.tech/horeca_inventory?sslmode=require"

# Secret used to sign session JWTs (HS256). Generate a strong random value,
# e.g.: openssl rand -base64 32
AUTH_SECRET="REPLACE_ME_FAKE_AUTH_SECRET"

# ---------------------------------------------------------------------------
# Grit BizSuite integration (ALL OPTIONAL — leave unset to run standalone;
# event publishing and cron drains simply stay inert).
# ---------------------------------------------------------------------------

# Shared HMAC secret for @grit/shared-events internal webhooks.
#GRIT_EVENT_WEBHOOK_SECRET="REPLACE_ME_SHARED_EVENT_SECRET"

# Bearer secret protecting GET/POST /api/cron/events-drain (outbox retry).
#CRON_SECRET="REPLACE_ME_CRON_SECRET"

# Base URLs for the AppSwitcher cross-app nav (@grit/passport defaults to
# localhost dev ports 3000-3003 when unset).
#GRIT_POS_URL="http://localhost:3000"
#GRIT_INVENTORY_URL="http://localhost:3001"
#GRIT_TASKBOARD_URL="http://localhost:3002"
#GRIT_REPORTS_URL="http://localhost:3003"

# Comma-separated subscriber URLs notified on inventory.threshold_breached.
#GRIT_SUBSCRIBERS_INVENTORY_THRESHOLD_BREACHED="http://localhost:3002/api/events/grit"

# Comma-separated subscriber URLs notified on inventory.transfer_completed.
#GRIT_SUBSCRIBERS_INVENTORY_TRANSFER_COMPLETED="http://localhost:3003/api/events/grit"

# ---------------------------------------------------------------------------
# Seed script (npm run db:seed)
# ---------------------------------------------------------------------------

# Email and password for the initial admin user created by the seed script.
# Only used during db:seed, ignored at runtime. Defaults: admin@demo.invento /
# changeme123
#SEED_ADMIN_EMAIL="admin@demo.invento"
#SEED_ADMIN_PASSWORD="changeme123"
